{
    "name": "gsebastiao/laravel-auditable",
    "description": "Auditoria Eloquent com nomes legíveis (resolveMap), operações multi-tabela agrupadas por batch, auditoria de falhas, restauro de registros apagados e multitenancy opcional.",
    "keywords": ["laravel", "audit", "auditing", "activity-log", "eloquent", "multitenancy", "saas", "audit-trail"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Gabriel Sebastião"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.4|^12.0|^13.0",
        "illuminate/contracts": "^11.4|^12.0|^13.0",
        "illuminate/database": "^11.4|^12.0|^13.0",
        "illuminate/filesystem": "^11.4|^12.0|^13.0",
        "illuminate/http": "^11.4|^12.0|^13.0",
        "illuminate/support": "^11.4|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Gsebastiao\\Auditable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gsebastiao\\Auditable\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gsebastiao\\Auditable\\AuditableServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
