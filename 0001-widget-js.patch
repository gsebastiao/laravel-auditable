+        return fetch(url, { method: 'POST', headers: headers, body: body, credentials: 'same-origin' })
+            .then(function (res) {
+                if (!res.ok) {
+                    var err = new Error('Requisição falhou com status ' + res.status);
+                    err.status = res.status;
+                    throw err;
+                }
+                return res.json();
+            });
